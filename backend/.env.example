# ========================================
# Fillax Backend — Environment Variables
# Copy this file to `.env` and fill in your keys.
# ========================================

APP_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase Configurations (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Anthropic Claude API Key (Required for AI assistant)
ANTHROPIC_API_KEY=sk-ant-api53-your-key

# Omise Payment Gateway Key (Optional in Dev simulation, Required in Prod)
OMISE_SECRET_KEY=skey_test_5xyz...
OMISE_PUBLIC_KEY=pkey_test_5xyz...

# Omise Webhook Secret (Required for secure payment confirmation callback)
OMISE_WEBHOOK_SECRET=whsec_your_webhook_secret

# LINE Messaging API Configs (Optional)
LINE_CHANNEL_ACCESS_TOKEN=your-line-access-token
LINE_CHANNEL_SECRET=your-line-secret
