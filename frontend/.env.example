# ========================================
# Fillax Frontend — Environment Variables
# Copy this file to `.env.local` and fill in your keys.
# ========================================

# Supabase Public Configurations (Accessible by browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# PromptPay ID for Dynamic QR Payment (Phone number or National ID)
NEXT_PUBLIC_PROMPTPAY_ID=08xxxxxxxx

# SQLite/Prisma Local DB connection string (if applicable)
DATABASE_URL="file:./dev.db"
